<svg width="800" height="500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="grad" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#090d16" stop-opacity="1.0"/>
    </radialGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="8" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <rect width="100%" height="100%" fill="#090d16"/>
  <rect width="100%" height="100%" fill="url(#grad)"/>
  <circle cx="400" cy="200" r="90" fill="none" stroke="#38bdf8" stroke-width="4" opacity="0.6"/>
  <polygon points="400,140 435,230 365,230" fill="#38bdf8" opacity="0.8" filter="url(#glow)"/>
  <text x="400" y="330" font-family="system-ui, -apple-system, sans-serif" font-size="28" font-weight="bold" fill="#ffffff" text-anchor="middle">SparkSync</text>
  <text x="400" y="375" font-family="system-ui, -apple-system, sans-serif" font-size="18" fill="#94a3b8" text-anchor="middle">iOS App Icon</text>
  <text x="400" y="420" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="600" fill="#38bdf8" text-anchor="middle">RADIANT SPARK LLC · OFFICIAL ASSET</text>
</svg>